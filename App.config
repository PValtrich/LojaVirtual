<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
    <connectionStrings>
        <!-- Para usar outro servidor ou instância, altere apenas o Data Source -->
        <add name="LojaVirtual"
             connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=LojaVirtual;Integrated Security=SSPI;"
             providerName="System.Data.SqlClient" />
    </connectionStrings>
</configuration>